#include<stdio.h>

    int insertion(int arr[],int size,int element ,int index){
        int i;
        for(i =size - 1 ; i<=index;i--){
            arr[i+1]=arr[i];
        }
        arr[index]=element;
        size++;
        return 1;
    }
int main(){
    int arr[100],size,element,index,i;
    printf("Enter the size of the array");
    scanf("%d",&size);
    printf("Enter the elements of the array");
    for(i=0;i<size;i++){
        scanf("%d",&arr[i]);
    }
    printf("Enter the element to be inserted");
    scanf("%d",&element);
    printf("Enter the index at which the element is to be inserted");
    scanf("%d",&index);
    insertion(arr,size,element,index);
    printf("The new array is");
    for(i=0;i<size;i++){
        printf("%d ",arr[i]);
    }
    return 0;
}
